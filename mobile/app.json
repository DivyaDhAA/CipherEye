{
  "expo": {
    "name": "CipherEye AI",
    "slug": "divyapdd",
    "scheme": "ciphereye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ciphereye.app"
    },
    "android": {
      "package": "com.ciphereye.scamprotection",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc7b6610-0685-4dc1-b399-d73943819b10"
      }
    },
    "owner": "divyadharshinivijayans-team"
  }
}
